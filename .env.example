# PROJECT APEX — copy to .env and adjust. Never commit real secrets.
# All API variables use the APEX_ prefix. Execution mode is NOT configurable (always ANALYSIS_ONLY).

# --- API -------------------------------------------------------------------
APEX_ENVIRONMENT=development            # development | test | production
APEX_DATABASE_URL=postgresql+asyncpg://apex:apex_dev_password@localhost:5432/apex
APEX_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APEX_SECRET_KEY=change-me-to-a-long-random-value
# Required to create the first admin via the web UI in production (optional in development).
APEX_BOOTSTRAP_TOKEN=
APEX_COOKIE_SECURE=false                # must be true in production (HTTPS)
APEX_CORS_ORIGINS=["http://localhost:3000"]
APEX_LOG_LEVEL=INFO
APEX_LOG_JSON=true
# Signed-in requests are limited per user; anonymous per client IP.
APEX_RATE_LIMIT_PER_MINUTE=240
APEX_USER_RATE_LIMIT_PER_MINUTE=1200
# Peers allowed to set X-Forwarded-For (the web server / reverse proxy).
APEX_TRUSTED_PROXIES=["127.0.0.1","::1"]

# --- Scanner and risk assumptions -----------------------------------------
APEX_SCANNER_INTERVAL_SECONDS=20
APEX_ALERT_COOLDOWN_SECONDS=900
APEX_COST_COMMISSION_PER_SIDE_STANDARD=2.50
APEX_COST_COMMISSION_PER_SIDE_MICRO=0.60
APEX_COST_SLIPPAGE_TICKS_PER_SIDE=1
APEX_ACCOUNT_STALE_MINUTES=30

# --- Market data (Phase 2) -------------------------------------------------
# none      : no prices are shown anywhere (default)
# simulated : synthetic prices for development, labelled SIMULATED on every screen
# databento : Databento GLBX.MDP3 - historical backfill (clamped to the published cutoff) + Live API bars
APEX_MARKET_DATA_PROVIDER=none
APEX_MARKET_DATA_SYMBOLS=["ES","MES","NQ","MNQ","YM","MYM","RTY","M2K","CL","MCL","GC","MGC"]
APEX_MARKET_DATA_BACKFILL_HOURS=72
APEX_MARKET_DATA_STALE_SECONDS=150
APEX_DATABENTO_API_KEY=
# Continuous front month: v = previous-day volume (default), c = calendar, n = open interest
APEX_DATABENTO_ROLL_RULE=v
# Databento HTTP: read timeout per request (seconds) and bounded retries with exponential backoff
# for free metadata calls (cost estimates). Billed downloads are never retried after reaching Databento.
APEX_DATABENTO_TIMEOUT_SECONDS=60
APEX_DATABENTO_MAX_RETRIES=3

# --- AI copilot (Phase 5, server-side only) --------------------------------
APEX_ANTHROPIC_API_KEY=
APEX_COPILOT_MODEL=claude-opus-5-5
APEX_COPILOT_EFFORT=medium
APEX_COPILOT_RATE_LIMIT_PER_MINUTE=12

# --- Economic calendar ------------------------------------------------------
APEX_CALENDAR_PRE_EVENT_MINUTES=15
APEX_CALENDAR_POST_EVENT_MINUTES=15
# Official .ics URLs fetched every 6 hours by the worker, e.g. ["https://www.bls.gov/schedule/news_release/bls.ics"]
APEX_CALENDAR_ICS_URLS=[]
# Minimum NET reward:risk to Target 1 (after commission and slippage) for READY and the readiness
# checklist. Conservative default 1.5; lowering it is a deliberate risk decision (test it first with
# python -m app.cli rr-study).
APEX_MIN_NET_REWARD_RISK=1.5
# READY only for strategies the latest research study classifies as validated (see docs/research-methodology.md).
APEX_REQUIRE_VALIDATED_STRATEGY=true
# ForexFactory weekly calendar export (impact-rated), fetched hourly by the worker. false to disable.
APEX_CALENDAR_FOREXFACTORY=true
# News intelligence (re-evaluated every 60 s against the cached calendar; the source itself is downloaded
# at most hourly). Caution windows around high-impact USD releases, in minutes, and when the cache is stale.
APEX_CALENDAR_PRE_EVENT_MINUTES=15
APEX_CALENDAR_POST_EVENT_MINUTES=15
APEX_NEWS_UPCOMING_MINUTES=60
APEX_NEWS_ACTIVE_AFTER_MINUTES=5
APEX_NEWS_STALE_HOURS=3

# --- Web -------------------------------------------------------------------
# Where the Next.js server proxies /api/* (server-side only).
APEX_API_ORIGIN=http://127.0.0.1:8000
# WebSocket endpoint the browser connects to.
NEXT_PUBLIC_APEX_WS_URL=ws://localhost:8000/api/ws

# --- Docker Compose --------------------------------------------------------
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex_dev_password
POSTGRES_DB=apex

# --- Automation (docs/automation.md) -------------------------------------------------------------
# PROJECT APEX is analysis only. Keep APEX_MANUAL: no orders and no simulated autopilot (the autopilot
# task is not even started in this mode). The other modes are retained for reference only.
APEX_AUTOMATION_MODE=APEX_MANUAL
APEX_AUTOPILOT_STRATEGIES=["ES:mtf_trend:t1_all","NQ:breakout_retest:t2_all"]
APEX_AUTOPILOT_CONTRACTS=1
APEX_AUTOPILOT_MAX_RISK_PER_TRADE=500
APEX_BROKER_ADAPTER=
APEX_BROKER_ACCOUNT_TYPE=
APEX_BROKER_LIVE_ENABLED=false

# --- Phone notifications: none | ntfy | pushover | telegram (keep secrets in .env only) ------------
APEX_NOTIFY_PROVIDER=none
APEX_NOTIFY_MIN_SEVERITY=info
APEX_NOTIFY_NTFY_URL=
APEX_NOTIFY_NTFY_TOKEN=
APEX_NOTIFY_PUSHOVER_TOKEN=
APEX_NOTIFY_PUSHOVER_USER=
APEX_NOTIFY_TELEGRAM_BOT_TOKEN=
APEX_NOTIFY_TELEGRAM_CHAT_ID=
