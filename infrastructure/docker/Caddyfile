# Example reverse proxy: one HTTPS origin for the dashboard, API and WebSocket.
# Caddy obtains and renews the TLS certificate automatically for the domain below.
apex.example.com {
	encode gzip

	# API and WebSocket (/api/ws) go to FastAPI; Caddy proxies WebSocket upgrades transparently.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Everything else is the Next.js dashboard.
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
